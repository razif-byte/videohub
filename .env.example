# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for direct YouTube search and metadata.
# If left as DEFAULT_KEY or empty, Video Hub uses official embedded player and direct URL playback fallback.
YOUTUBE_API_KEY=DEFAULT_KEY

# FREE_REELS_BASE_URL: Base URL for FreeReels provider (configurable in Settings).
FREE_REELS_BASE_URL=https://freereels.com
